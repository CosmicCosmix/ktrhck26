@page
@model Forex.Pages.BrowseModel
@{
    ViewData["Title"] = "Browse Equipment";
}

<div class="top-bar" style="justify-content: space-between; align-items: center;">
    <h2 style="font-weight: 300; margin: 0;">Available Equipment</h2>
    
    <form method="get" style="display: flex; gap: 1rem; align-items: center;">
        <select name="category" class="form-control" style="width: auto; background-color: var(--bg-color);" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var cat in Model.Categories)
            {
                if (Model.SelectedCategory == cat)
                {
                    <option value="@cat" selected>@cat</option>
                }
                else
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
        <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search by name..." style="width: 250px;" />
        <button type="submit" class="btn btn-outline">Filter</button>
    </form>
</div>

@if (!Model.Equipments.Any())
{
    <div style="text-align: center; padding: 4rem; color: var(--text-secondary);">
        No equipment found matching your criteria.
    </div>
}
else
{
    <div class="grid">
        @foreach (var item in Model.Equipments)
        {
            <div class="card" style="display: flex; flex-direction: column; cursor: pointer;" onclick="openModal('@item.Id')">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <div style="height: 180px; background-image: url('@item.ImageUrl'); background-size: cover; background-position: center; border-radius: var(--border-radius); margin-bottom: 1rem;"></div>
                }
                else
                {
                    <div style="height: 180px; background-color: var(--hover-bg); border-radius: var(--border-radius); margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; color: var(--text-secondary);">
                        No Image
                    </div>
                }
                
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 500;">@item.Name</h3>
                    <span class="badge">@item.Condition</span>
                </div>
                
                <div style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1rem;">
                    @item.Manufacturer @item.Model &bull; @item.Category
                </div>
                
                <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 600; font-size: 1.1rem;">₹@item.HourlyRate <span style="font-size: 0.8rem; font-weight: 400; color: var(--text-secondary);">/ hr</span></div>
                    </div>
                    <div style="text-align: right; font-size: 0.85rem; color: var(--text-secondary);">
                        @item.Organization?.Name<br/>
                        @item.Organization?.City
                    </div>
                </div>
            </div>
            
            <!-- Modal for details -->
            <div id="modal-@item.Id" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
                <div style="background: var(--bg-color); border: 1px solid var(--border-color); border-radius: var(--border-radius); width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; padding: 2rem; position: relative;">
                    <button type="button" onclick="closeModal('@item.Id')" style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; color: var(--text-primary); cursor: pointer; font-size: 1.5rem;">&times;</button>
                    
                    <h2 style="margin-top: 0;">@item.Name</h2>
                    <p style="color: var(--text-secondary);">Owned by @item.Organization?.Name</p>
                    
                    <div style="margin: 1.5rem 0; font-size: 0.95rem;">
                        @item.Description
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                        <div style="padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--border-radius);">
                            <div style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 0.25rem;">Hourly Rate</div>
                            <div style="font-weight: 500; font-size: 1.2rem;">₹@item.HourlyRate</div>
                        </div>
                        <div style="padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--border-radius);">
                            <div style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 0.25rem;">Daily Rate</div>
                            <div style="font-weight: 500; font-size: 1.2rem;">@(item.DailyRate.HasValue ? $"₹{item.DailyRate}" : "N/A")</div>
                        </div>
                    </div>
                    
                    <h4 style="margin-bottom: 1rem;">Request Schedule</h4>
                    <form method="post" asp-page-handler="Book">
                        <input type="hidden" name="EquipmentId" value="@item.Id" />
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>Start Date & Time</label>
                                <input type="datetime-local" name="StartTime" class="form-control" style="background-color: var(--bg-color); color: var(--text-primary);" required />
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>End Date & Time</label>
                                <input type="datetime-local" name="EndTime" class="form-control" style="background-color: var(--bg-color); color: var(--text-primary);" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Purpose</label>
                            <textarea name="Purpose" class="form-control" rows="3" placeholder="Briefly describe what you will use this equipment for..."></textarea>
                        </div>
                        <button type="button" class="btn btn-primary" style="width: 100%; padding: 0.75rem;" onclick="alert('Booking request stub triggered. Payment flow not integrated.')">Request Booking</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function openModal(id) {
            document.getElementById('modal-' + id).style.display = 'flex';
        }
        function closeModal(id) {
            document.getElementById('modal-' + id).style.display = 'none';
        }
        
        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.id && event.target.id.startsWith('modal-')) {
                event.target.style.display = "none";
            }
        }
    </script>
}
