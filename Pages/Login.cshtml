@page
@model Forex.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div style="max-width: 400px; margin: 4rem auto;">
    <h2 style="font-weight: 300; margin-bottom: 2rem; text-align: center;">Welcome back</h2>

    @if (!ModelState.IsValid)
    {
        <div style="padding: 1rem; margin-bottom: 1.5rem; border: 1px solid #ff3333; border-radius: var(--border-radius); color: #ff3333; font-size: 0.9rem;">
            Invalid email or password.
        </div>
    }

    <form method="post">
        <div class="form-group">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" class="form-control" type="email" required />
        </div>
        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" type="password" required />
        </div>
        
        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Sign in</button>
    </form>
    
    <div style="margin-top: 2rem; text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
        Don't have an account? <a asp-page="/Register" style="color: var(--text-primary);">Register here</a>
    </div>
</div>
