@page
@model Forex.Pages.RentModel
@{
    ViewData["Title"] = "Rent Out Equipment";
}

<div style="max-width: 800px; margin: 0 auto;">
    <h2 style="font-weight: 300; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">List New Equipment</h2>

    @if (Model.StatusMessage != null)
    {
        <div style="padding: 1rem; margin-bottom: 2rem; border: 1px solid #4CAF50; border-radius: var(--border-radius); color: #4CAF50; font-size: 0.9rem;">
            @Model.StatusMessage
        </div>
    }

    <form method="post" style="margin-bottom: 4rem;">
        <div class="grid" style="gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.Name">Equipment Name *</label>
                <input asp-for="Input.Name" class="form-control" required />
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.Category">Category *</label>
                <input asp-for="Input.Category" class="form-control" placeholder="e.g. Imaging, Sequencing..." required />
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.Manufacturer">Manufacturer</label>
                <input asp-for="Input.Manufacturer" class="form-control" />
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.Model">Model</label>
                <input asp-for="Input.Model" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Description">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="grid" style="gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.Condition">Condition</label>
                <select asp-for="Input.Condition" class="form-control" style="background-color: var(--bg-color);">
                    <option value="New">New</option>
                    <option value="Excellent">Excellent</option>
                    <option value="Good" selected>Good</option>
                    <option value="Fair">Fair</option>
                </select>
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.ImageUrl">Image URL</label>
                <input asp-for="Input.ImageUrl" class="form-control" type="url" placeholder="https://..." />
            </div>
        </div>

        <div class="grid" style="gap: 1.5rem; margin-bottom: 2rem; padding: 1.5rem; border: 1px solid var(--border-color); border-radius: var(--border-radius);">
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.HourlyRate">Hourly Rate (₹) *</label>
                <input asp-for="Input.HourlyRate" class="form-control" type="number" step="0.01" min="0" required />
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.DailyRate">Daily Rate (₹)</label>
                <input asp-for="Input.DailyRate" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Input.SecurityDeposit">Security Deposit (₹)</label>
                <input asp-for="Input.SecurityDeposit" class="form-control" type="number" step="0.01" min="0" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary" style="padding: 0.75rem 2rem;">List Equipment</button>
    </form>


    <h2 style="font-weight: 300; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">Your Listed Equipment</h2>
    
    @if (!Model.MyEquipment.Any())
    {
        <div style="text-align: center; padding: 2rem; color: var(--text-secondary); border: 1px dashed var(--border-color); border-radius: var(--border-radius);">
            You haven't listed any equipment yet.
        </div>
    }
    else
    {
        <div class="grid" style="grid-template-columns: 1fr;">
            @foreach (var item in Model.MyEquipment)
            {
                <div class="card" style="display: flex; gap: 1.5rem; align-items: center;">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <div style="width: 120px; height: 120px; background-image: url('@item.ImageUrl'); background-size: cover; background-position: center; border-radius: var(--border-radius); flex-shrink: 0;"></div>
                    }
                    else
                    {
                        <div style="width: 120px; height: 120px; background-color: var(--hover-bg); border-radius: var(--border-radius); flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--text-secondary); font-size: 0.8rem;">No Image</div>
                    }
                    
                    <div style="flex-grow: 1;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                            <h3 style="margin: 0; font-size: 1.1rem;">@item.Name</h3>
                            <span class="badge" style="border-color: @(item.Status == "available" ? "#4CAF50" : "var(--border-color)"); color: @(item.Status == "available" ? "#4CAF50" : "var(--text-secondary)");">@item.Status</span>
                        </div>
                        <div style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1rem;">
                            @item.Category &bull; ₹@item.HourlyRate / hr
                        </div>
                        <div style="font-size: 0.85rem;">
                            Listed on @item.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
